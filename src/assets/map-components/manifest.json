{
  "version": 2,
  "coordinateSystem": "orthographic-top-down",
  "anchor": "center",
  "gridBasis": "1 footprint unit = 1 tactical grid cell",
  "palette": {
    "outlineWarmGray": "#b8aa9a",
    "bodyBrownBlack": "#2b2724",
    "bodyRaised": "#3a332d",
    "surfaceDark": "#171311",
    "functionalPurple": "#704080",
    "statusGold": "#c58a00"
  },
  "stateColorGuidance": {
    "normal": "Keep the source palette.",
    "active": "Increase functionalPurple opacity or replace the smallest status marker with statusGold; do not add glow.",
    "locked": "Use statusGold on the latch or access marker only.",
    "alarm": "Replace functionalPurple status surfaces with the theme madder pigment; keep geometry and outline unchanged.",
    "offline": "Desaturate functionalPurple to #5f5660 and remove the statusGold marker.",
    "damaged": "Lower body fill contrast and add a separate crack decal; do not recolor the full object red.",
    "selected": "Selection rings belong to the map UI layer and must not be baked into these SVGs."
  },
  "components": [
    {
      "id": "cryo-pod",
      "file": "cryo-pod.svg",
      "canvas": "64x64",
      "recommendedFootprint": { "width": 4, "height": 5 },
      "anchor": "center",
      "movement": "blocked",
      "vision": "transparent",
      "cover": "threeQuarters",
      "stateColors": { "closed": "functionalPurple", "open": "statusGold", "occupied": "retain warm-gray silhouette", "offline": "offline", "damaged": "damaged" }
    },
